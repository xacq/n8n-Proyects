    {
      "parameters": {
        "jsCode": "const key = Object.keys($input.item.binary)[0];\nconst buffer = $input.item.binary[key].data;\nconst base64Image = buffer.toString('base64');\n\nreturn [{\n  json: {\n    content: base64Image,\n    mimeType: $input.item.binary[key].mimeType,\n    fileName: $input.item.binary[key].fileName\n  }\n}];"
      },
