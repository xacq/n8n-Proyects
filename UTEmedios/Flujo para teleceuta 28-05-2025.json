    {
      "parameters": {
        "jsCode": "const categorySet = new Set();\n\nfor (const item of items) {\n  const categories = item.json.categories || [];\n  for (const id of categories) {\n    categorySet.add(id);\n  }\n}\n\n// Convertimos el Set en un array de un solo item para la siguiente llamada HTTP\nreturn [{\n  json: {\n    ids: Array.from(categorySet).join(',')  // \"1,2,3\"\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
