    {
      "parameters": {
        "jsCode": "// Obtener los datos originales\nconst posts = $items('HTTP Request verificar noticias existentes');\nconst categories = $items('HTTP Request Verifica las categorias');\n\n// Mapeamos ID -> nombre para búsqueda rápida\nconst categoryMap = {};\nfor (const cat of categories) {\n  categoryMap[cat.json.id] = cat.json.name;\n}\n\nconst results = [];\n\n// Para cada post, mapeamos sus IDs de categorías a nombres\nfor (const post of posts) {\n  const catIds = post.json.categories || [];\n  const catNames = catIds.map(id => categoryMap[id] || 'Desconocida');\n\n  results.push({\n    json: {\n      ...post.json,\n      category_names: catNames\n    }\n  });\n}\n\nreturn results;\n"
      },
