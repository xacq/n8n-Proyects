        "jsCode": "const query = $('When Executed by Another Workflow').first().json.query || \"\";\n\n// Tomar solo el primer texto que tenga formato de link (por si viene acompañado de otros datos)\nconst rawLink = query.split(' ')[0];\n\n// Buscar ID en la URL de Google Drive\nconst match = rawLink.match(/\\/d\\/([a-zA-Z0-9_-]+)\\//);\n\nif (match && match[1]) {\n  const fileId = match[1];\n  const cleanLink = `https://drive.google.com/uc?export=download&id=${fileId}`;\n\n  return [\n    {\n      json: {\n        originalLink: rawLink,\n        fileId,\n        cleanLink\n      }\n    }\n  ];\n} else {\n  return [\n    {\n      json: {\n        error: \"No se pudo extraer el ID del link.\",\n        originalLink: rawLink\n      }\n    }\n  ];\n}\n"
